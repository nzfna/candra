{
  "name": "@candra/id",
  "version": "0.1.0",
  "description": "Curated Indonesian language pack: messages, i18next/next-intl adapters, Intl formatting and typed keys.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "messages", "i18next", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./messages": { "types": "./dist/messages.d.ts", "import": "./dist/messages.js", "require": "./dist/messages.cjs" },
    "./messages/*": "./messages/*.json",
    "./i18next": { "types": "./dist/i18next.d.ts", "import": "./dist/i18next.js", "require": "./dist/i18next.cjs" },
    "./i18next/*": "./i18next/*.json",
    "./format": { "types": "./dist/format.d.ts", "import": "./dist/format.js", "require": "./dist/format.cjs" },
    "./types": { "types": "./dist/types.d.ts", "import": "./dist/types.js", "require": "./dist/types.cjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "prepack": "node ../../tools/release/prepack.mjs",
    "prebuild": "node ../../tools/lint-pack/lint.mjs && node ../../tools/build-pack/build.mjs",
    "build": "tsup src/index.ts src/messages.ts src/i18next.ts src/format.ts src/types.ts --format esm,cjs --dts --clean",
    "typecheck": "node ../../tools/build-pack/build.mjs && tsc --noEmit",
    "test": "vitest run"
  }
}
